{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ELITEAYOTO/Tokn/benchmarks/manifest.schema.json",
  "title": "Tokn BenchmarkManifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "task_id",
    "run_id",
    "condition",
    "repository",
    "prompt",
    "runtime",
    "tokn",
    "run_order",
    "observed_at",
    "quality_gate_version",
    "exclusion_policy_version",
    "cache_condition"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "benchmark_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "condition": { "type": "string", "minLength": 1 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "commit"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] },
        "provider": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "reasoning_effort": { "type": ["string", "null"] }
      }
    },
    "tokn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "version"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "version": { "type": "string", "minLength": 1 },
        "policy_id": { "type": ["string", "null"] }
      }
    },
    "run_order": { "type": "integer", "minimum": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "quality_gate_version": { "type": "string", "minLength": 1 },
    "exclusion_policy_version": { "type": "string", "minLength": 1 },
    "cache_condition": {
      "enum": [
        "UNKNOWN",
        "RECORDED_NOT_RESET",
        "CONTROLLED_COLD",
        "CONTROLLED_WARM"
      ]
    },
    "inclusion_status": {
      "enum": ["INCLUDED", "EXCLUDED_PREDECLARED"]
    },
    "evidence_notes": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  }
}
